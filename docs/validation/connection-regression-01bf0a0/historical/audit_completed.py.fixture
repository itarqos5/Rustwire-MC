#!/usr/bin/env python3
"""Reassess completed runs using the exact published strict Paper cache classifier."""
import hashlib,json,pathlib,re,sys
sys.dont_write_bytecode=True
R=pathlib.Path(__file__).resolve().parent
sys.path.insert(0,str(R/'source/tools/paper'))
import validate_chunk_updates as published
classifier=R/'source/tools/paper/validate_chunk_updates.py'
sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
proof={'classifier':str(classifier.relative_to(R)),'classifier_sha256':sha(classifier),'harness_sha256':sha(pathlib.Path(__file__)),'gate_version':'paper-generated-remap-classpath-v2','results':[]}
for filename in ['results.json','continuation-results.json']:
    path=R/filename
    if not path.exists(): continue
    raw=json.loads(path.read_text())
    for row in raw['results']:
        world=R/'servers'/row['version']
        lines=[re.sub(r'\x1b\[[0-?]*[ -/]*[@-~]','',line).strip() for line in (world/'server.log').read_text().splitlines()]
        audit=published.audit_plugins(world,lines)
        protocol_pass=(all(t['exit']==0 for t in row['tests']) and len(row['tests'])==2 and row.get('client_clean_shutdown') and row.get('server_clean_disconnect') and row.get('joined_server_side') and row.get('counters',{}).get('chunks',0)>=4 and row.get('counters',{}).get('keepalives',0)>=1 and row.get('semantic',{}).get('elapsed_ms',0)>=20000)
        cleanup_pass=(row['server_exit']==0 and not row['forced_shutdown'] and not row['listeners_after'] and row['eula_unchanged'] and row['ops_empty'] and audit['passed'])
        proof['results'].append({'version':row['version'],'original_report':filename,'original_report_sha256':sha(path),'original_passed':row['passed'],'original_cleanup_failure':row.get('cleanup_failure',False),'protocol_passed':bool(protocol_pass),'strict_cleanup_passed':bool(cleanup_pass),'passed':bool(protocol_pass and cleanup_pass),'plugin_safety':audit})
proof['all_completed_passed']=all(row['passed'] for row in proof['results'])
(R/'strict-cleanup-assessment.json').write_text(json.dumps(proof,indent=2)+'\n')
print(json.dumps({'completed':len(proof['results']),'all_completed_passed':proof['all_completed_passed'],'classifier_sha256':proof['classifier_sha256']}))
for row in proof['results']:
    if not row['passed']:print(json.dumps(row))
raise SystemExit(0 if proof['all_completed_passed'] else 1)
